# Local development (Django on localhost:8000)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# In production on Vercel set this to a relative path so the Vercel rewrite
# in vercel.json proxies /api/* to your Cloud Run URL (no CORS needed):
#   VITE_API_BASE_URL=/api/v1
# Or set it to your Cloud Run URL directly and enable CORS on Django:
#   VITE_API_BASE_URL=https://irms-api-xxxxx-zw.a.run.app/api/v1

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=rpa-irms-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rpa-irms-dev
VITE_FIREBASE_STORAGE_BUCKET=rpa-irms-dev.appspot.com
VITE_FIREBASE_APP_ID=1:0:web:0

# Set to 0 in production so the SPA talks to real Firebase Auth.
VITE_USE_AUTH_EMULATOR=1
VITE_AUTH_EMULATOR_URL=http://localhost:9099

VITE_PUBLIC_VERIFY_URL=http://localhost:5173/verify
